# HostelFix Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=5001
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Admin Portal
ADMIN_REGISTRATION_KEY=HostelFix@Admin2026

# Cloudinary Image Storage (Persistent Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Transactional Email Service (Render HTTPS API)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=HostelFix <noreply@hostelfix.chitkara.edu.in>


