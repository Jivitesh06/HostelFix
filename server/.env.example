# HostelFix Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=5001
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Admin Portal
ADMIN_REGISTRATION_KEY=HostelFix@Admin2026

# Cloudinary Image Storage (Persistent Image Uploads)
# Sign up at https://cloudinary.com and find these in Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail API (OAuth 2.0) — Email Delivery
# See docs/GMAIL_API_SETUP.md for setup instructions
# Run: node scripts/google-oauth.js to obtain GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_FROM=your-gmail@gmail.com


